{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev:app": "deno run --allow-env --allow-sys --allow-ffi --env-file --allow-net --allow-read --allow-write --allow-run vite --port 3020",
    "dev:docker": "docker compose up",
    "dev": {
      "dependencies": ["dev:app", "dev:docker"]
    },
    "build": "deno run -A --env-file=.env.prod vite build",
    "start": "deno run --allow-net --allow-read --allow-write --allow-ffi --allow-env --env-file=.env.prod --allow-sys ./.output/server/index.mjs",
    "db:generate": "deno -A --node-modules-dir --env-file drizzle-kit generate",
    "db:migrate": "deno -A --node-modules-dir --env-file drizzle-kit migrate",
    "db:studio": "deno -A --env-file --node-modules-dir drizzle-kit studio --port 8000",
    "db-prod:migrate": "deno -A --node-modules-dir --env-file=.env.prod drizzle-kit migrate",
    "db-prod:studio": "deno -A --node-modules-dir --env-file=.env.prod drizzle-kit studio --port 8000",
    "check": "deno fmt ./src/ && deno lint ./src/ && deno check ./src/",
    "audit": "deno audit",
    "audit:fix": "deno audit fix",
    "deps:update": "deno outdated --update --latest \"!vite\""
  },
  "lint": {
    "rules": {
      "include": [
        "explicit-function-return-type",
        "eqeqeq",
        "camelcase",
        "guard-for-in",
        "no-inferrable-types",
        "no-slow-types",
        "verbatim-module-syntax",
        "single-var-declarator",
        "triple-slash-reference",
        "no-useless-rename",
        "no-self-compare",
        "no-throw-literal",
        "no-sync-fn-in-async-fn",
        "no-sparse-arrays",
        "no-console",
        "no-eval",
        "no-await-in-loop",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "explicit-module-boundary-types"
      ],
      "exclude": [
        "jsx-key"
      ],
      "tags": [
        "recommended",
        "jsx"
      ]
    },
    "plugins": [
      "jsr:@ayk/lint-import-order",
      "jsr:@ryu/deno-lint-plugin-tailwindcss"
    ]
  },
  "imports": {
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.1067.0",
    "@cf-wasm/photon": "npm:@cf-wasm/photon@^0.1.27",
    "@fontsource-variable/inter": "npm:@fontsource-variable/inter@^5.2.6",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.111",
    "@iconify-json/simple-icons": "npm:@iconify-json/simple-icons@^1.2.86",
    "date-fns": "npm:date-fns@^4.4.0",
    "unplugin-icons": "npm:unplugin-icons@^23.0.1",
    "~/": "./src/",
    "@nerimity/solid-turnstile": "npm:@nerimity/solid-turnstile@^1.1.0",
    "@orpc/client": "npm:@orpc/client@^1.14.6",
    "@orpc/experimental-pino": "npm:@orpc/experimental-pino@^1.14.6",
    "@orpc/openapi": "npm:@orpc/openapi@^1.14.6",
    "@orpc/openapi-client": "npm:@orpc/openapi-client@^1.14.6",
    "@orpc/server": "npm:@orpc/server@^1.14.6",
    "@orpc/zod": "npm:@orpc/zod@^1.14.6",
    "@ark-ui/solid": "npm:@ark-ui/solid@^5.37.1",
    "@better-auth/drizzle-adapter": "npm:@better-auth/drizzle-adapter@^1.6.17",
    "@better-auth/passkey": "npm:@better-auth/passkey@^1.6.17",
    "@corvu/calendar": "npm:@corvu/calendar@^0.1.2",
    "@corvu/drawer": "npm:@corvu/drawer@^0.2.4",
    "@corvu/otp-field": "npm:@corvu/otp-field@^0.1.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "@kobalte/core": "npm:@kobalte/core@^0.13.11",
    "@kobalte/tailwindcss": "npm:@kobalte/tailwindcss@^0.9.0",
    "@libsql/client": "npm:@libsql/client@^0.17.3",
    "@seven.io/client": "npm:@seven.io/client@^5.6.0",
    "@solidjs/meta": "npm:@solidjs/meta@^0.29.4",
    "@solidjs/router": "npm:@solidjs/router@^0.16.1",
    "@solidjs/start": "npm:@solidjs/start@2.0.0-alpha.3",
    "@solidjs/vite-plugin-nitro-2": "npm:@solidjs/vite-plugin-nitro-2@0.3.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "better-auth": "npm:better-auth@^1.6.17",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "cmdk-solid": "npm:cmdk-solid@^1.1.2",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.2",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4-273829f",
    "drizzle-zod": "npm:drizzle-zod@1.0.0-beta.14-a36c63d",
    "embla-carousel-solid": "npm:embla-carousel-solid@^8.6.0",
    "lefthook": "npm:lefthook@^2.1.9",
    "@types/nodemailer": "npm:@types/nodemailer@^8.0.1",
    "nodemailer": "npm:nodemailer@^8.0.11",
    "pino": "npm:pino@^10.3.1",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "qrcode": "npm:qrcode@^1.5.4",
    "resend": "npm:resend@^6.12.4",
    "solid-js": "npm:solid-js@^1.9.13",
    "solid-sonner": "npm:solid-sonner@^0.3.1",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "tw-animate-css": "npm:tw-animate-css@^1.4.0",
    "vite": "npm:vite@^7.3.5",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "types": [
      "vite/client",
      "unplugin-icons/types/solid"
    ],
    "paths": {
      "~icons/*": ["./node_modules/unplugin-icons/types/solid.d.ts"]
    }
  },
  "allowScripts": ["npm:lefthook"]
}
